rules_version = '2';

// ハイブリッド構成:
//   配信は GitHub Pages、Firebase は Firestore へのログ書き込みと匿名の集計にのみ使用する。
//   安全性はルールで担保する（NEXT_PUBLIC_* の秘匿では守らない）。
service cloud.firestore {
  match /databases/{database}/documents {

    // 被験者セッションログ：書き込みのみ（閲覧は管理者のみ）
    match /sessions/{docId} {
      allow create, update: if true;
      allow read, delete: if false;
    }

    // 他プレイヤー比較用の匿名集計（人数カウントのみ）。
    // 誰でも読めるが、1人分の加算＝「n と、本編・事後・タイプの区分を1つずつ」を+1する更新だけを許可する。
    match /stats/{statId} {
      function gKeys() { return ['g0', 'g1', 'g2', 'g3', 'g4', 'g5', 'g6'].toSet(); }
      function pKeys() { return ['p0', 'p1', 'p2', 'p3', 'p4', 'p5', 'p6'].toSet(); }
      function tKeys() { return ['t_detective', 't_cautious', 't_trusting', 't_intuitive', 't_balanced', 't_growing'].toSet(); }
      // 1人分の区分の組み合わせ：n＋g1つ＋p1つ＋t1つ（ちょうど4キー）
      function onePerson(keys) {
        return keys.size() == 4
          && keys.hasAll(['n'])
          && keys.intersection(gKeys()).size() == 1
          && keys.intersection(pKeys()).size() == 1
          && keys.intersection(tKeys()).size() == 1;
      }
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function incOk(k) {
        return !(k in changed()) || request.resource.data[k] == resource.data.get(k, 0) + 1;
      }

      allow get: if statId == 'festival2026';
      allow create: if statId == 'festival2026'
        && onePerson(request.resource.data.keys().toSet())
        && request.resource.data.values().hasOnly([1]);
      allow update: if statId == 'festival2026'
        && onePerson(changed())
        && incOk('n')
        && incOk('g0') && incOk('g1') && incOk('g2') && incOk('g3') && incOk('g4') && incOk('g5') && incOk('g6')
        && incOk('p0') && incOk('p1') && incOk('p2') && incOk('p3') && incOk('p4') && incOk('p5') && incOk('p6')
        && incOk('t_detective') && incOk('t_cautious') && incOk('t_trusting') && incOk('t_intuitive')
        && incOk('t_balanced') && incOk('t_growing');
      allow list, delete: if false;
    }

    // 上記以外へのアクセスはすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
