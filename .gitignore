# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# orchestrator
orchestrator/kb_index.db
orchestrator/search_log.jsonl
orchestrator/__pycache__/

# analysis: サービスアカウント鍵（DB全権限の秘密情報）とエクスポート済みデータは絶対にコミットしない
**/serviceAccountKey.json
**/*firebase-adminsdk*.json
analysis/*.json
analysis/data/
analysis/__pycache__/
